# Cloudflare Pages headers for the Astro site.
#
# PRODUCTION POSTURE, set at the apex cutover. The site is now findable in
# regular search AND AI search, which is the point of having it. The site-wide
# `X-Robots-Tag: noindex, nofollow` that kept the preview out of every index is
# gone; the AI model-training opt-out in robots.txt STAYS, because refusing
# training and wanting to be findable are different things.
#
# If this site is ever put back behind a preview hostname, restore the noindex
# line here and the preview note in robots.txt together. One without the other
# does not work: robots.txt cannot hide a page whose noindex header it is also
# blocking a crawler from reading.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com

# Long-cache the fingerprinted build assets and the web fonts. The fonts are
# unmodified copies of the licensed Manifold DSA WOFF2 files, NOT subsets: the
# typeface is CC BY-NC-ND, and NoDerivatives rules subsetting out. See
# LICENSE-fonts. They are safe to cache immutably because the weights never
# change in place.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
